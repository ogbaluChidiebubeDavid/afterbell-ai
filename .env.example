# ==========================================
# EXBIT AI - CONFIGURATION ENVIRONMENT
# ==========================================

# Execution Mode: STRICTLY "paper" FOR HACKATHON EVALUATION
EXBIT_EXECUTION_MODE=paper
AFTERBELL_EXECUTION_MODE=paper

# Anthropic Claude API (Primary Decision Engine)
ANTHROPIC_API_KEY=

# Google Gemini API (Alternative / Fallback LLM)
GEMINI_API_KEY=

# Bitget Agent Hub MCP Configuration
BITGET_AGENTIC_ACCOUNT_ID=bitget_agent_exbit_demo
BITGET_MCP_SERVER_URL=http://localhost:3001
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# ==========================================
# Facebook Messenger (Meta Graph API)
# ==========================================
# 1. Official Facebook Page: https://facebook.com/ExbitBot
# 2. Direct Messenger Chat: https://m.me/ExbitBot
# 3. Add "Messenger" product in Meta Developers and generate Page Access Token:
MESSENGER_PAGE_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
# 4. Webhook verification token (set in Meta App Dashboard):
MESSENGER_VERIFY_TOKEN=exbit_messenger_verify_token
# 5. Target recipient Page-Scoped ID (PSID) for trade notifications:
MESSENGER_RECIPIENT_ID=
MESSENGER_RECIPIENT_PSID=

# Trading Risk Guardrails (Non-negotiable defaults)
RISK_MAX_POSITION_USDT=500
RISK_DAILY_TRADE_CAP=3
RISK_MIN_CONFIDENCE_PERCENT=75
RISK_MAX_SLIPPAGE_PERCENT=0.35

# Public URLs & Facebook Page configuration
NEXT_PUBLIC_MESSENGER_PAGE_URL=https://m.me/ExbitBot
NEXT_PUBLIC_FACEBOOK_PAGE_URL=https://facebook.com/ExbitBot
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_BASE_URL=http://localhost:3000
