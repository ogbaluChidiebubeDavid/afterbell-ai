# ==========================================
# AFTERBELL AI - CONFIGURATION ENVIRONMENT
# ==========================================

# Execution Mode: STRICTLY "paper" FOR HACKATHON EVALUATION
AFTERBELL_EXECUTION_MODE=paper

# Anthropic Claude API (Primary Decision Engine)
ANTHROPIC_API_KEY=

# Google Gemini API (Alternative / Fallback LLM)
GEMINI_API_KEY=

# Bitget Agent Hub MCP Configuration
BITGET_AGENTIC_ACCOUNT_ID=bitget_agent_afterbell_demo
BITGET_MCP_SERVER_URL=http://localhost:3001
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=

# Photon iMessage Service (https://photon.codes)
# Webhook and Outbound API credentials for iMessage channel
PHOTON_API_KEY=
PHOTON_API_ENDPOINT=https://api.photon.codes/v1
PHOTON_DESTINATION_PHONE=+15551234567
PHOTON_WEBHOOK_SECRET=afterbell_webhook_secret_key

# Trading Risk Guardrails (Non-negotiable defaults)
RISK_MAX_POSITION_USDT=500
RISK_DAILY_TRADE_CAP=3
RISK_MIN_CONFIDENCE_PERCENT=75
RISK_MAX_SLIPPAGE_PERCENT=0.35

# Next.js Public Flags
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_BASE_URL=http://localhost:3000
